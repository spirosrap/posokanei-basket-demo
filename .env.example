FTP_HOST=example.com
FTP_REMOTE_DIR=.
FTP_USER=your-ftp-user
# Use either FTP_PASS or FTP_KEYCHAIN_SERVICE.
# FTP_PASS=your-ftp-password
# FTP_KEYCHAIN_SERVICE=your-keychain-service-name
POSOKANEI_PUBLIC_CATALOG_URL=https://example.com/data/catalog.json
# Optional mirror for preserving a previous deployment.
# FTP_MIRROR_HOST=legacy.example.com
# FTP_MIRROR_REMOTE_DIR=demo/posokanei-basket
# FTP_MIRROR_USER=legacy-ftp-user
# Use either FTP_MIRROR_PASS or FTP_MIRROR_KEYCHAIN_SERVICE.
# FTP_MIRROR_PASS=legacy-ftp-password
# FTP_MIRROR_KEYCHAIN_SERVICE=legacy-keychain-service
# POSOKANEI_MIRROR_PUBLIC_CATALOG_URL=https://legacy.example.com/demo/posokanei-basket/data/catalog.json
# Optional: run the catalogue API fetch on another SSH host, then upload locally.
# POSOKANEI_REFRESH_HOST=runner-a
# Optional: try several SSH refresh runners in order. The first successful host wins.
# POSOKANEI_REFRESH_HOSTS=runner-a,runner-b
# Optional: override the browser-like request header used by the snapshot builder.
# POSOKANEI_USER_AGENT=Mozilla/5.0 ...
# Daily AI bargain generation runs locally. Keep OPENAI_API_KEY in the Mac's
# private shell/LaunchAgent environment; never upload it with the static app.
# OPENAI_BARGAIN_MODEL=gpt-5.6-sol
# OPENAI_BARGAIN_REASONING=high
# POSOKANEI_BARGAIN_TIME_ZONE=Europe/Athens
VITE_LIVE_APP_URL=https://kalathitimon.com/
# Set only when rebuilding the preserved legacy deployment.
# VITE_APP_BASE=/demo/posokanei-basket/
