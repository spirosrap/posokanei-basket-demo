{
  "name": "posokanei-basket-demo",
  "version": "0.32.5",
  "description": "Fast web app for comparing a Greek supermarket basket across chains using live PosoKanei catalog data.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://kalathitimon.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/spirosrap/posokanei-basket-demo.git"
  },
  "keywords": [
    "posokanei",
    "supermarket",
    "price-comparison",
    "shopping-basket",
    "react",
    "vite",
    "greece"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prepare-build-assets.mjs && node scripts/check-performance-budget.mjs",
    "build:legacy": "VITE_APP_BASE=/demo/posokanei-basket/ vite build && node scripts/prepare-build-assets.mjs && node scripts/check-performance-budget.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "node --test src/*.test.js",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "bargain:daily": "node scripts/generate-daily-bargain.mjs",
    "catalog:snapshot": "node scripts/build-catalog-snapshot.mjs",
    "catalog:runtime": "node scripts/build-catalog-runtime.mjs",
    "catalog:bootstrap": "node scripts/build-catalog-bootstrap.mjs",
    "price-changes:preview": "node scripts/build-price-changes-preview.mjs",
    "live:install-refresh": "node scripts/install-live-refresh-launchd.mjs",
    "live:deploy": "node scripts/deploy-live.mjs",
    "live:deploy:mirror": "npm run build:legacy && node scripts/deploy-live.mjs --mirror",
    "live:deploy:config": "node scripts/deploy-live.mjs --config-only",
    "live:deploy:config:mirror": "node scripts/deploy-live.mjs --mirror --config-only",
    "live:deploy:bootstrap": "node scripts/deploy-live.mjs --bootstrap-only",
    "live:deploy:bootstrap:mirror": "node scripts/deploy-live.mjs --mirror --bootstrap-only",
    "live:deploy:preview": "node scripts/deploy-live.mjs --preview-only",
    "live:deploy:preview:mirror": "node scripts/deploy-live.mjs --mirror --preview-only",
    "live:deploy:runtime": "node scripts/deploy-live.mjs --runtime-only",
    "live:deploy:runtime:mirror": "node scripts/deploy-live.mjs --mirror --runtime-only",
    "live:deploy:compression": "node scripts/refresh-live-catalog.mjs --compression-only",
    "live:refresh": "node scripts/refresh-live-catalog.mjs",
    "check:updates": "node scripts/check-posokanei-updates.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "preact": "^10.29.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
